{
  "$defs": {
    "AppearanceConfig": {
      "additionalProperties": false,
      "properties": {
        "theme": {
          "$ref": "#/$defs/Theme"
        }
      },
      "required": [
        "theme"
      ],
      "type": "object"
    },
    "ApplicationConfig": {
      "additionalProperties": false,
      "properties": {
        "command_timeout_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "default_refresh_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_concurrent_commands": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_output_bytes_per_run": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "shell": {
          "type": "string"
        },
        "working_directories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "command_timeout_seconds",
        "default_refresh_seconds",
        "max_concurrent_commands",
        "max_output_bytes_per_run",
        "shell",
        "working_directories"
      ],
      "type": "object"
    },
    "AutocompleteConfig": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "debounce_milliseconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "instruction": {
          "type": "string"
        },
        "minimum_characters": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "debounce_milliseconds",
        "instruction",
        "minimum_characters"
      ],
      "type": "object"
    },
    "ButtonConfig": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "default": false,
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "ButtonListsConfig": {
      "additionalProperties": false,
      "properties": {
        "advanced": {
          "items": {
            "$ref": "#/$defs/ButtonConfig"
          },
          "type": "array"
        },
        "always": {
          "items": {
            "$ref": "#/$defs/ButtonConfig"
          },
          "type": "array"
        }
      },
      "required": [
        "advanced",
        "always"
      ],
      "type": "object"
    },
    "ButtonsConfig": {
      "additionalProperties": false,
      "properties": {
        "issues": {
          "$ref": "#/$defs/ButtonListsConfig"
        },
        "pull_requests": {
          "$ref": "#/$defs/ButtonListsConfig"
        }
      },
      "required": [
        "issues",
        "pull_requests"
      ],
      "type": "object"
    },
    "ChatAgentConfig": {
      "additionalProperties": false,
      "description": "Defines the commands that run one turn of a chat conversation.",
      "properties": {
        "resume": {
          "description": "Runs every later turn of a conversation and receives that turn's message text.",
          "type": "string"
        },
        "start": {
          "description": "Runs the first turn of a conversation and receives that turn's message text.",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "Limits how long one turn may run before it is interrupted.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "resume",
        "start",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "ChatCommandConfig": {
      "additionalProperties": false,
      "description": "Names one chat command and describes it in the help reply.",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "description": "Is the first word of a message that runs this command, such as `/ai`.",
          "type": "string"
        }
      },
      "required": [
        "description",
        "name"
      ],
      "type": "object"
    },
    "ChatCommandsConfig": {
      "additionalProperties": false,
      "description": "Names the commands that control chat conversations.\n\nA message that does not start with one of these names is queued for the conversation's next turn.",
      "properties": {
        "help": {
          "$ref": "#/$defs/ChatCommandConfig"
        },
        "model": {
          "$ref": "#/$defs/ChatCommandConfig"
        },
        "start": {
          "$ref": "#/$defs/ChatCommandConfig"
        },
        "status": {
          "$ref": "#/$defs/ChatCommandConfig"
        },
        "steer": {
          "$ref": "#/$defs/ChatCommandConfig"
        },
        "stop": {
          "$ref": "#/$defs/ChatCommandConfig"
        }
      },
      "required": [
        "help",
        "model",
        "start",
        "status",
        "steer",
        "stop"
      ],
      "type": "object"
    },
    "ChatConfig": {
      "additionalProperties": false,
      "description": "Connects coding-agent conversations to an external chat through configured commands.",
      "properties": {
        "acknowledgement": {
          "description": "Runs after the dashboard accepts a message, for example to add a reaction.",
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "$ref": "#/$defs/ChatAgentConfig"
        },
        "commands": {
          "$ref": "#/$defs/ChatCommandsConfig"
        },
        "listener": {
          "$ref": "#/$defs/ChatListenerConfig"
        },
        "models": {
          "$ref": "#/$defs/ChatModelsConfig"
        },
        "reply": {
          "$ref": "#/$defs/ChatReplyConfig"
        },
        "working_directory": {
          "description": "Is the current working directory for every chat command and must be one of `application.working_directories`.",
          "type": "string"
        }
      },
      "required": [
        "agent",
        "commands",
        "listener",
        "models",
        "reply",
        "working_directory"
      ],
      "type": "object"
    },
    "ChatListenerConfig": {
      "additionalProperties": false,
      "description": "Defines the long-running command that prints incoming chat messages.",
      "properties": {
        "command": {
          "description": "Prints a ready event after connecting, then incoming messages as JSON lines.",
          "type": "string"
        },
        "recovery": {
          "description": "Repairs listener dependencies or authentication before another connection attempt.",
          "type": [
            "string",
            "null"
          ]
        },
        "recovery_timeout_seconds": {
          "description": "Bounds each recovery command, including any interactive authentication.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "restart_attempts": {
          "description": "Limits restarts before a listener failure stops the dashboard.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "restart_seconds": {
          "description": "Is the delay before the dashboard restarts a listener that exited.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "startup_timeout_seconds": {
          "description": "Bounds the wait for an explicit ready event from each connection attempt.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "recovery_timeout_seconds",
        "restart_attempts",
        "restart_seconds",
        "startup_timeout_seconds"
      ],
      "type": "object"
    },
    "ChatModelsConfig": {
      "additionalProperties": false,
      "description": "Lists the models that chat conversations can select.",
      "properties": {
        "available": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default": {
          "description": "Is the model for new conversations and must be one of `available`.",
          "type": "string"
        }
      },
      "required": [
        "available",
        "default"
      ],
      "type": "object"
    },
    "ChatReplyConfig": {
      "additionalProperties": false,
      "description": "Defines how the dashboard posts replies into a conversation.",
      "properties": {
        "command": {
          "type": "string"
        },
        "prefix": {
          "description": "Starts every reply so the dashboard can ignore its own replies when the listener prints them.",
          "type": "string"
        }
      },
      "required": [
        "command",
        "prefix"
      ],
      "type": "object"
    },
    "ItemKind": {
      "enum": [
        "issue",
        "pull_request"
      ],
      "type": "string"
    },
    "PartialRootConfig": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppearanceConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "autocomplete": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutocompleteConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "buttons": {
          "anyOf": [
            {
              "$ref": "#/$defs/ButtonsConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "chat": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatConfig"
            },
            {
              "type": "null"
            }
          ]
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/SectionConfig"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PromptConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "placeholder"
      ],
      "type": "object"
    },
    "SectionConfig": {
      "additionalProperties": false,
      "properties": {
        "cache_ttl_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "collapsed": {
          "default": false,
          "type": "boolean"
        },
        "command": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "item_kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "items_per_page": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "refresh_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "cache_ttl_seconds",
        "command",
        "id",
        "item_kind",
        "items_per_page",
        "title"
      ],
      "type": "object"
    },
    "Theme": {
      "enum": [
        "dark",
        "light",
        "system"
      ],
      "type": "string"
    }
  },
  "$id": "https://personal-dashboard.local/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/juharris/optify/refs/heads/main/schemas/feature_file.json"
    }
  ],
  "description": "Optify feature file whose options are validated by Personal Dashboard.",
  "properties": {
    "options": {
      "anyOf": [
        {
          "$ref": "#/$defs/PartialRootConfig"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "Personal Dashboard Optify Feature",
  "type": "object"
}
